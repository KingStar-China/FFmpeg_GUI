<Window x:Class="FFmpegGui.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="FFmpeg GUI"
        Width="1280"
        Height="800"
        MinWidth="1080"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource WindowForeground}"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        Drop="Window_Drop"
        Closing="Window_Closing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <!--
            控件模板仍使用 .NET Fluent，但颜色由窗口统一提供。
            这样不会覆盖 Fluent 的隐式模板，也不会把系统强调色（例如粉色）带进深色界面。
        -->
        <SolidColorBrush x:Key="ButtonBackground" Color="#302A38" />
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#3C3348" />
        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#493B58" />
        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#25212C" />
        <SolidColorBrush x:Key="ButtonForeground" Color="#F4F0F8" />
        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#F4F0F8" />
        <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#8C8494" />

        <SolidColorBrush x:Key="AccentButtonBackground" Color="#3B78B4" />
        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#4A8CCB" />
        <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#2E5F91" />
        <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#2B3948" />
        <SolidColorBrush x:Key="AccentButtonForeground" Color="#F8FBFF" />
        <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF" />
        <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#E8F2FF" />
        <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#9DAFBE" />

        <SolidColorBrush x:Key="ComboBoxBackground" Color="#2B2533" />
        <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#352D3E" />
        <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#40354B" />
        <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#211D27" />
        <SolidColorBrush x:Key="ComboBoxForeground" Color="#F4F0F8" />
        <SolidColorBrush x:Key="ComboBoxForegroundPointerOver" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ComboBoxForegroundPressed" Color="#F4F0F8" />
        <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ComboBoxForegroundFocusedPressed" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="#8C8494" />

        <SolidColorBrush x:Key="TextControlBackground" Color="#2B2533" />
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#352D3E" />
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#332A3E" />
        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#211D27" />
        <SolidColorBrush x:Key="TextControlForeground" Color="#F4F0F8" />
        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#8C8494" />

        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#4A3B62" />
        <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#F8F4FF" />
        <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundThemeBrush" Color="#3A3150" />
        <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundPointerOverThemeBrush" Color="#493D62" />
        <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundPressedThemeBrush" Color="#574873" />
        <SolidColorBrush x:Key="ListBoxItemSelectedForegroundThemeBrush" Color="#F8F4FF" />

        <Style x:Key="SecondaryText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <StatusBar DockPanel.Dock="Bottom" Padding="8,3">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalContentAlignment="Right">
                <ProgressBar Width="180"
                             Height="16"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding ProgressValue, Mode=OneWay}"
                             IsIndeterminate="{Binding IsProgressIndeterminate}" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock MinWidth="40"
                           TextAlignment="Right"
                           Text="{Binding ProgressValue, StringFormat={}{0}%}" />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="210" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="24" FontWeight="SemiBold" Text="FFmpeg GUI" />
                        <Border Margin="10,3,0,0"
                                Padding="8,2"
                                CornerRadius="10"
                                Background="#0F6CBD">
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="White"
                                       Text="v0.2.1" />
                        </Border>
                    </StackPanel>
                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource SecondaryText}"
                               Text="{Binding ToolStatus}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Margin="0,0,8,0"
                            Style="{DynamicResource DefaultButtonStyle}"
                            Content="{Binding ImportButtonText}"
                            IsEnabled="{Binding CanModifyInputs}"
                            Click="ImportMain_Click" />
                    <Button Margin="0,0,8,0"
                            Style="{DynamicResource DefaultButtonStyle}"
                            Content="添加媒体文件"
                            IsEnabled="{Binding CanModifyInputs}"
                            Click="AddMedia_Click" />
                    <Button Margin="0,0,8,0"
                            Style="{DynamicResource DefaultButtonStyle}"
                            Content="清空文件"
                            IsEnabled="{Binding CanModifyInputs}"
                            Click="ClearMedia_Click" />
                    <Button Content="清空勾选"
                            Style="{DynamicResource DefaultButtonStyle}"
                            IsEnabled="{Binding CanModifyInputs}"
                            Click="ClearSelection_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0"
                        Margin="0,0,0,10"
                        Padding="12,8"
                        IsEnabled="{Binding CanModifyInputs}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                        CornerRadius="6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,18,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource SectionTitle}"
                                   Text="工作模式" />
                        <RadioButton Margin="0,0,18,0"
                                     Style="{DynamicResource DefaultRadioButtonStyle}"
                                     VerticalAlignment="Center"
                                     Content="单文件"
                                     GroupName="WorkMode"
                                     IsChecked="{Binding IsSingleFileMode, Mode=TwoWay}" />
                        <RadioButton VerticalAlignment="Center"
                                     Style="{DynamicResource DefaultRadioButtonStyle}"
                                     Content="批量"
                                     GroupName="WorkMode"
                                     IsChecked="{Binding IsBatchMode, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230" MinWidth="190" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" MinWidth="520" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="350" MinWidth="320" MaxWidth="420" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Grid.ColumnSpan" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBatchMode}" Value="True">
                                        <Setter Property="Grid.ColumnSpan" Value="3" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <GroupBox Header="输入文件">
                            <DockPanel>
                                <Button DockPanel.Dock="Top"
                                        Margin="4,4,4,8"
                                        HorizontalAlignment="Left"
                                        Style="{DynamicResource DefaultButtonStyle}"
                                        Content="{Binding SelectAllBatchLabel}"
                                        IsEnabled="{Binding CanSelectAllBatch}"
                                        Visibility="{Binding CanSelectAllBatch, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="SelectAllBatch_Click" />
                                <ListBox ItemsSource="{Binding MediaItems}"
                                         BorderThickness="0"
                                         HorizontalContentAlignment="Stretch">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="3,5" ToolTip="{Binding InputPath}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0"
                                                          Margin="0,0,10,0"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Style="{DynamicResource DefaultCheckBoxStyle}"
                                                          IsEnabled="{Binding IsSelectable}"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          ToolTip="{Binding SelectableReason}"
                                                          Visibility="{Binding DataContext.IsBatchMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               Text="{Binding FileName}" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               Style="{StaticResource SecondaryText}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Text="{Binding Details}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </GroupBox>
                    </Grid>

                    <GridSplitter Grid.Column="1"
                                  Width="6"
                                  HorizontalAlignment="Stretch"
                                  ResizeDirection="Columns"
                                  Visibility="{Binding IsSingleFileMode, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <GroupBox Grid.Column="2"
                              Header="轨道表"
                              Visibility="{Binding IsSingleFileMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DataGrid x:Name="TracksGrid"
                                  ItemsSource="{Binding Tracks}"
                                  IsEnabled="{Binding CanModifyInputs}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="True"
                                  CanUserResizeColumns="True"
                                  CanUserSortColumns="True"
                                  ColumnWidth="*"
                                  ColumnHeaderStyle="{DynamicResource CenteredDataGridColumnHeaderStyle}"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  PreviewMouseRightButtonDown="TracksGrid_PreviewMouseRightButtonDown">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="按当前模式全选" Click="SelectAll_Click" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Resources>
                                <SolidColorBrush x:Key="DataGridRowSelectedBackgroundThemeBrush" Color="#3A3150" />
                                <SolidColorBrush x:Key="DataGridRowSelectedForegroundThemeBrush" Color="#F8F4FF" />
                                <Style x:Key="CenteredDataGridTextStyle" TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="TextAlignment" Value="Center" />
                                </Style>
                                <Style x:Key="CenteredDataGridColumnHeaderStyle"
                                       TargetType="DataGridColumnHeader"
                                       BasedOn="{StaticResource DefaultDataGridColumnHeaderStyle}">
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <!-- Fluent 模板右侧预留排序指示器空间；保留必要的偏移补偿，避免窄列文字区被吃光。 -->
                                    <Setter Property="Padding" Value="14,0,0,0" />
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource DefaultDataGridCellStyle}">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource DefaultDataGridRowStyle}">
                                    <Setter Property="ToolTip" Value="{Binding Tooltip}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSupported}" Value="False">
                                            <Setter Property="Opacity" Value="0.55" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <!--
                                    先按表头和控件的自动最小宽度兜底；有剩余空间时由 * 平均分给每一列。
                                    剩余空间为 0 或负数时保持这些最小宽度，并由 DataGrid 的水平滚动条承载超出部分。
                                -->
                                <DataGridTemplateColumn Width="*" MinWidth="44" Header="保留">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      VerticalContentAlignment="Center"
                                                      MinWidth="0"
                                                      Padding="0"
                                                      Style="{DynamicResource DefaultCheckBoxStyle}"
                                                      IsEnabled="{Binding IsSelectable}"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Width="*" MinWidth="44" Header="来源" Binding="{Binding SourceLabel}" ElementStyle="{StaticResource CenteredDataGridTextStyle}" IsReadOnly="True" />
                                <DataGridTextColumn Width="*" MinWidth="44" Header="轨道" Binding="{Binding StreamIndex}" ElementStyle="{StaticResource CenteredDataGridTextStyle}" IsReadOnly="True" />
                                <DataGridTextColumn Width="*" MinWidth="44" Header="类型" Binding="{Binding KindDisplay}" ElementStyle="{StaticResource CenteredDataGridTextStyle}" IsReadOnly="True" />
                                <DataGridTextColumn Width="*" MinWidth="68" Header="Codec" Binding="{Binding Codec}" ElementStyle="{StaticResource CenteredDataGridTextStyle}" IsReadOnly="True" />
                                <DataGridTemplateColumn Width="*" MinWidth="100" Header="目标编码">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox MinWidth="0"
                                                      HorizontalAlignment="Stretch"
                                                      HorizontalContentAlignment="Center"
                                                      Style="{DynamicResource DefaultComboBoxStyle}"
                                                      ItemsSource="{Binding TargetOptions}"
                                                      SelectedItem="{Binding SelectedTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      DisplayMemberPath="Label"
                                                      ToolTip="{Binding TargetCodec}"
                                                      IsEnabled="{Binding IsSelectable}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Width="*" MinWidth="44" Header="语言" Binding="{Binding Language}" ElementStyle="{StaticResource CenteredDataGridTextStyle}" IsReadOnly="True" />
                                <DataGridTextColumn Width="*" MinWidth="44" Header="标题" Binding="{Binding Title}" ElementStyle="{StaticResource CenteredDataGridTextStyle}" IsReadOnly="True" />
                                <DataGridTextColumn Width="*" MinWidth="44" Header="标记" Binding="{Binding Flags}" ElementStyle="{StaticResource CenteredDataGridTextStyle}" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <GridSplitter Grid.Column="3"
                                  Width="6"
                                  HorizontalAlignment="Stretch"
                                  ResizeDirection="Columns" />

                    <Grid Grid.Column="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                            <GroupBox Margin="0,0,0,10" Header="当前选择">
                                <TextBlock TextWrapping="Wrap" Text="{Binding SummaryText}" />
                            </GroupBox>

                            <GroupBox Margin="0,0,0,10"
                                      Header="输出设置"
                                      IsEnabled="{Binding CanModifyInputs}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0"
                                               Grid.Column="0"
                                               Margin="0,5,10,8"
                                               Text="格式" />
                                    <ComboBox Grid.Row="0"
                                              Grid.Column="1"
                                              Grid.ColumnSpan="2"
                                              Margin="0,0,0,8"
                                              Style="{DynamicResource DefaultComboBoxStyle}"
                                              ItemsSource="{Binding OutputOptions}"
                                              SelectedItem="{Binding SelectedOutputOption, Mode=TwoWay}"
                                              DisplayMemberPath="Label" />
                                    <TextBlock Grid.Row="1"
                                               Grid.Column="0"
                                               Margin="0,5,10,0"
                                               Text="路径" />
                                     <TextBox Grid.Row="1"
                                              Grid.Column="1"
                                              Margin="0,0,8,0"
                                              Style="{DynamicResource DefaultTextBoxStyle}"
                                              IsEnabled="{Binding CanChooseOutput}"
                                              ToolTip="{Binding OutputPath}"
                                              Text="{Binding OutputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Row="1"
                                            Grid.Column="2"
                                            Style="{DynamicResource DefaultButtonStyle}"
                                            Content="{Binding OutputBrowseLabel}"
                                            IsEnabled="{Binding CanChooseOutput}"
                                            Click="BrowseOutput_Click" />
                                </Grid>
                            </GroupBox>

                            <GroupBox Margin="0,0,0,10" Header="规则校验">
                                <TextBlock TextWrapping="Wrap"
                                           ToolTip="{Binding ValidationDetails}"
                                           Text="{Binding ValidationText}" />
                            </GroupBox>

                            <GroupBox Margin="0,0,0,10"
                                      Header="已选轨道顺序"
                                      Visibility="{Binding IsSingleFileMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="120" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <ListBox Grid.Row="0"
                                             ItemsSource="{Binding SelectedTrackItems}"
                                             SelectedItem="{Binding SelectedOrderItem, Mode=TwoWay}"
                                             DisplayMemberPath="DisplayText"
                                             ToolTip="单文件模式下可调整输出轨道顺序。" />
                                    <StackPanel Grid.Row="1"
                                                Margin="0,8,0,0"
                                                HorizontalAlignment="Right"
                                                Orientation="Horizontal">
                                        <Button Width="46"
                                                Margin="0,0,8,0"
                                                Style="{DynamicResource DefaultButtonStyle}"
                                                Content="↑"
                                                ToolTip="上移"
                                                IsEnabled="{Binding CanMoveSelectedTrack}"
                                                Click="MoveUp_Click" />
                                        <Button Width="46"
                                                Style="{DynamicResource DefaultButtonStyle}"
                                                Content="↓"
                                                ToolTip="下移"
                                                IsEnabled="{Binding CanMoveSelectedTrack}"
                                                Click="MoveDown_Click" />
                                    </StackPanel>
                                </Grid>
                            </GroupBox>

                            </StackPanel>
                        </ScrollViewer>

                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Style="{DynamicResource AccentButtonStyle}"
                                    MinHeight="42"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    IsDefault="True"
                                    Content="{Binding RunButtonText}"
                                    IsEnabled="{Binding CanRun}"
                                    Click="Run_Click" />
                            <Button Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Style="{DynamicResource DefaultButtonStyle}"
                                    Content="取消"
                                    IsEnabled="{Binding CanCancel}"
                                    Click="Cancel_Click" />
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <TabControl Grid.Row="2" Margin="0,12,0,0">
                <TabItem Header="命令预览">
                    <TextBox Margin="8"
                             Style="{DynamicResource DefaultTextBoxStyle}"
                             Padding="8"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             FontFamily="Consolas"
                             FontSize="12"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto"
                             IsReadOnly="True"
                             TextWrapping="NoWrap"
                             Text="{Binding CommandPreview, Mode=OneWay}" />
                </TabItem>
                <TabItem Header="任务日志">
                    <TextBox x:Name="LogBox"
                             Margin="8"
                             Style="{DynamicResource DefaultTextBoxStyle}"
                             Padding="8"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             FontFamily="Consolas"
                             FontSize="12"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto"
                             IsReadOnly="True"
                             TextWrapping="NoWrap"
                             TextChanged="LogBox_TextChanged"
                             Text="{Binding LogText, Mode=OneWay}" />
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>

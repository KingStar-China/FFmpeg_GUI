<Window x:Class="FFmpegGui.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="FFmpeg GUI"
        Width="1280"
        Height="800"
        MinWidth="1080"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        Drop="Window_Drop"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="SecondaryText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <StatusBar DockPanel.Dock="Bottom" Padding="8,3">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalContentAlignment="Right">
                <ProgressBar Width="180"
                             Height="16"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding ProgressValue, Mode=OneWay}"
                             IsIndeterminate="{Binding IsProgressIndeterminate}" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock MinWidth="40"
                           TextAlignment="Right"
                           Text="{Binding ProgressValue, StringFormat={}{0}%}" />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="210" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="24" FontWeight="SemiBold" Text="FFmpeg GUI" />
                        <Border Margin="10,3,0,0"
                                Padding="8,2"
                                CornerRadius="10"
                                Background="#0F6CBD">
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="White"
                                       Text="Windows 原生版 · v0.2.0" />
                        </Border>
                    </StackPanel>
                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource SecondaryText}"
                               Text="{Binding ToolStatus}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Margin="0,0,8,0"
                            Content="导入主文件"
                            IsEnabled="{Binding CanModifyInputs}"
                            Click="ImportMain_Click" />
                    <Button Margin="0,0,8,0"
                            Content="添加媒体文件"
                            IsEnabled="{Binding CanModifyInputs}"
                            Click="AddMedia_Click" />
                    <Button Margin="0,0,8,0"
                            Content="清空文件"
                            IsEnabled="{Binding CanModifyInputs}"
                            Click="ClearMedia_Click" />
                    <Button Content="清空勾选"
                            IsEnabled="{Binding CanModifyInputs}"
                            Click="ClearSelection_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0"
                        Margin="0,0,0,10"
                        Padding="12,8"
                        IsEnabled="{Binding CanModifyInputs}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                        CornerRadius="6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,18,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource SectionTitle}"
                                   Text="工作模式" />
                        <RadioButton Margin="0,0,18,0"
                                     VerticalAlignment="Center"
                                     Content="单文件"
                                     GroupName="WorkMode"
                                     IsChecked="{Binding IsSingleFileMode, Mode=TwoWay}" />
                        <RadioButton VerticalAlignment="Center"
                                     Content="批量"
                                     ToolTip="批量模式暂未开放"
                                     GroupName="WorkMode"
                                     IsEnabled="False"
                                     IsChecked="{Binding IsBatchMode, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230" MinWidth="190" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" MinWidth="420" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="350" MinWidth="320" MaxWidth="420" />
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0" Header="输入文件">
                        <ListBox ItemsSource="{Binding MediaItems}"
                                 BorderThickness="0"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="3,5" ToolTip="{Binding InputPath}">
                                        <TextBlock FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding FileName}" />
                                        <TextBlock Margin="0,2,0,0"
                                                   Style="{StaticResource SecondaryText}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding Details}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </GroupBox>

                    <GridSplitter Grid.Column="1"
                                  Width="6"
                                  HorizontalAlignment="Stretch"
                                  ResizeDirection="Columns" />

                    <GroupBox Grid.Column="2" Header="轨道表">
                        <DataGrid x:Name="TracksGrid"
                                  ItemsSource="{Binding Tracks}"
                                  IsEnabled="{Binding CanModifyInputs}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="True"
                                  CanUserResizeColumns="True"
                                  CanUserSortColumns="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  PreviewMouseRightButtonDown="TracksGrid_PreviewMouseRightButtonDown">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="Padding" Value="8,0" />
                                    <Setter Property="MinHeight" Value="36" />
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="按当前模式全选" Click="SelectAll_Click" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="ToolTip" Value="{Binding Tooltip}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSupported}" Value="False">
                                            <Setter Property="Opacity" Value="0.55" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="72" MinWidth="72" Header="保留">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      IsEnabled="{Binding IsSelectable}"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Width="78" MinWidth="78" Header="来源" Binding="{Binding SourceLabel}" IsReadOnly="True" />
                                <DataGridTextColumn Width="72" MinWidth="72" Header="轨道" Binding="{Binding StreamIndex}" IsReadOnly="True" />
                                <DataGridTextColumn Width="86" MinWidth="86" Header="类型" Binding="{Binding KindDisplay}" IsReadOnly="True" />
                                <DataGridTextColumn Width="104" MinWidth="104" Header="Codec" Binding="{Binding Codec}" IsReadOnly="True" />
                                <DataGridTemplateColumn Width="190" MinWidth="190" Header="目标编码">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox MinWidth="150"
                                                      ItemsSource="{Binding TargetOptions}"
                                                      SelectedItem="{Binding SelectedTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      DisplayMemberPath="Label"
                                                      ToolTip="{Binding TargetCodec}"
                                                      IsEnabled="{Binding IsSelectable}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Width="78" MinWidth="78" Header="语言" Binding="{Binding Language}" IsReadOnly="True" />
                                <DataGridTextColumn Width="*" MinWidth="140" Header="标题" Binding="{Binding Title}" IsReadOnly="True" />
                                <DataGridTextColumn Width="130" MinWidth="130" Header="标记" Binding="{Binding Flags}" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <GridSplitter Grid.Column="3"
                                  Width="6"
                                  HorizontalAlignment="Stretch"
                                  ResizeDirection="Columns" />

                    <Grid Grid.Column="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                            <GroupBox Margin="0,0,0,10" Header="当前选择">
                                <TextBlock TextWrapping="Wrap" Text="{Binding SummaryText}" />
                            </GroupBox>

                            <GroupBox Margin="0,0,0,10"
                                      Header="输出设置"
                                      IsEnabled="{Binding CanModifyInputs}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0"
                                               Grid.Column="0"
                                               Margin="0,5,10,8"
                                               Text="格式" />
                                    <ComboBox Grid.Row="0"
                                              Grid.Column="1"
                                              Grid.ColumnSpan="2"
                                              Margin="0,0,0,8"
                                              ItemsSource="{Binding OutputOptions}"
                                              SelectedItem="{Binding SelectedOutputOption, Mode=TwoWay}"
                                              DisplayMemberPath="Label" />
                                    <TextBlock Grid.Row="1"
                                               Grid.Column="0"
                                               Margin="0,5,10,0"
                                               Text="路径" />
                                     <TextBox Grid.Row="1"
                                              Grid.Column="1"
                                              Margin="0,0,8,0"
                                              IsEnabled="{Binding HasMedia}"
                                              ToolTip="{Binding OutputPath}"
                                              Text="{Binding OutputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Row="1"
                                            Grid.Column="2"
                                            Content="{Binding OutputBrowseLabel}"
                                            IsEnabled="{Binding CanModifyInputs}"
                                            Click="BrowseOutput_Click" />
                                </Grid>
                            </GroupBox>

                            <GroupBox Margin="0,0,0,10" Header="规则校验">
                                <TextBlock TextWrapping="Wrap"
                                           ToolTip="{Binding ValidationDetails}"
                                           Text="{Binding ValidationText}" />
                            </GroupBox>

                            <GroupBox Margin="0,0,0,10" Header="已选轨道顺序">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="120" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <ListBox Grid.Row="0"
                                             ItemsSource="{Binding SelectedTrackItems}"
                                             SelectedItem="{Binding SelectedOrderItem, Mode=TwoWay}"
                                             DisplayMemberPath="DisplayText"
                                             ToolTip="单文件模式下可调整输出轨道顺序。" />
                                    <StackPanel Grid.Row="1"
                                                Margin="0,8,0,0"
                                                HorizontalAlignment="Right"
                                                Orientation="Horizontal">
                                        <Button Width="46"
                                                Margin="0,0,8,0"
                                                Content="↑"
                                                ToolTip="上移"
                                                IsEnabled="{Binding CanMoveSelectedTrack}"
                                                Click="MoveUp_Click" />
                                        <Button Width="46"
                                                Content="↓"
                                                ToolTip="下移"
                                                IsEnabled="{Binding CanMoveSelectedTrack}"
                                                Click="MoveDown_Click" />
                                    </StackPanel>
                                </Grid>
                            </GroupBox>

                            </StackPanel>
                        </ScrollViewer>

                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    MinHeight="42"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    IsDefault="True"
                                    Content="{Binding RunButtonText}"
                                    IsEnabled="{Binding CanRun}"
                                    Click="Run_Click" />
                            <Button Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Content="取消"
                                    IsEnabled="{Binding CanCancel}"
                                    Click="Cancel_Click" />
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <TabControl Grid.Row="2" Margin="0,12,0,0">
                <TabItem Header="命令预览">
                    <TextBox Margin="8"
                             Padding="8"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             FontFamily="Consolas"
                             FontSize="12"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto"
                             IsReadOnly="True"
                             TextWrapping="NoWrap"
                             Text="{Binding CommandPreview, Mode=OneWay}" />
                </TabItem>
                <TabItem Header="任务日志">
                    <TextBox x:Name="LogBox"
                             Margin="8"
                             Padding="8"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             FontFamily="Consolas"
                             FontSize="12"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto"
                             IsReadOnly="True"
                             TextWrapping="NoWrap"
                             TextChanged="LogBox_TextChanged"
                             Text="{Binding LogText, Mode=OneWay}" />
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
